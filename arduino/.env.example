OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=gpt-4.1-mini,gpt-4o
BACKEND_API_URL=http://localhost:8080/api

# Para mostrar en el LCD los residuos/puntos registrados desde la web de produccion.
LCD_EVENT_POLLING_ENABLED=false
LCD_EVENT_API_URL=http://localhost:8080/api/recoleccion/eventos-lcd
LCD_EVENT_POLL_SECONDS=3

# Opcional: deja vacio para escuchar todos los camiones o coloca el id del camion asignado.
LCD_EVENT_CAMION_ID=
